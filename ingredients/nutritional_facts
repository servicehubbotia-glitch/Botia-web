<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>BOTIA — Nutritional facts</title><meta name="robots" content="noindex,nofollow"/><link rel="icon" href="/botia_jar_512.png" type="image/png"/>
<style>
:root{--bg:#100707;--panel:#180d0d;--panel2:#241010;--text:#f7eee8;--muted:#c9b3a6;--soft:#b99a88;--accent:#e6a06b;--accent2:#ffd8bd;--line:rgba(190,122,72,.28);--track:rgba(230,160,107,.12)}*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}body{min-height:100vh;background:radial-gradient(circle at 50% -10%,rgba(160,48,42,.16),transparent 40%),var(--bg)}.brand{display:flex;justify-content:center;align-items:center;gap:8px;padding:16px 0 10px;border-bottom:1px solid var(--line)}.brand img{width:22px;height:22px}.brand span{font-size:.78rem;color:var(--soft);letter-spacing:.06em}.brand b{color:var(--accent)}.wrap{max-width:620px;margin:auto;padding:30px 20px 42px}.eyebrow{color:var(--accent);font-size:.74rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;margin-bottom:10px}h1{font-size:1.85rem;margin:0 0 12px}.lead{color:var(--muted);line-height:1.65;margin:0 0 26px}.block-title{margin:30px 0 6px;font-size:1.05rem}.block-note{margin:0 0 14px;color:var(--soft);font-size:.83rem}.card,.ref-card{background:linear-gradient(180deg,var(--panel2),var(--panel));border:1px solid var(--line);border-radius:18px;padding:16px 18px;margin-bottom:14px}.basis{display:flex;justify-content:space-between;gap:12px;padding-bottom:12px;border-bottom:1px solid var(--line)}.basis-label{color:var(--soft);font-size:.76rem;text-transform:uppercase;letter-spacing:.1em;font-weight:800}.basis-value{color:var(--accent2);font-weight:700}.nutrition-row{display:grid;grid-template-columns:1fr auto;gap:14px;padding:12px 0;border-bottom:1px solid var(--line)}.nutrition-row:last-child{border-bottom:0}.nutrition-row.sub{padding-left:18px}.nutrition-row.sub .nutrient{color:var(--muted);font-size:.9rem}.amount{font-variant-numeric:tabular-nums;font-weight:700}.empty{border:1px dashed var(--line);border-radius:16px;padding:18px;color:var(--muted)}.ref-head{display:flex;justify-content:space-between;gap:14px}.ref-name{font-size:1rem;margin:0}.class-tag{font-size:.67rem;color:var(--accent2);border:1px solid var(--line);border-radius:999px;padding:5px 8px;height:max-content}.declared,.reference,.equivalent{color:var(--muted);font-size:.9rem;line-height:1.55}.bar-wrap{margin:16px 0 8px}.track{height:10px;background:var(--track);border:1px solid var(--line);border-radius:999px;overflow:hidden}.bar{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2))}.bar-meta{display:flex;justify-content:space-between;margin-top:7px;color:var(--soft);font-size:.76rem}.percent{color:var(--accent2);font-weight:800}.source{display:inline-block;margin-top:10px;color:var(--accent2);text-decoration:none;border-bottom:1px solid var(--line)}.method{margin-top:28px;padding:16px;border-left:3px solid var(--accent);background:rgba(230,160,107,.06);color:var(--muted);line-height:1.55;font-size:.88rem}.disclaimer{max-width:620px;margin:auto;padding:0 24px 34px;text-align:center;color:var(--soft);font-size:.75rem}[hidden]{display:none!important}
</style></head>
<body data-botia-module="nutrition_facts"><div class="brand"><img src="/botia_jar_512.png" alt=""/><span><b>BOTIA</b> · botia-safefood.com</span></div><main class="wrap"><div class="eyebrow" id="eyebrow">Declared data + official references</div><h1 id="title">Nutritional facts</h1><p class="lead" id="lead">BOTIA does not score the food. It shows what the label declares and, only when methodologically valid, places that value next to an applicable official reference.</p>
<h2 class="block-title" id="declared_title">What the label declares</h2><p class="block-note" id="declared_note">Pure label data. No rating.</p><section class="card" id="declared_card"><div class="basis"><span class="basis-label" id="basis_label">Basis</span><span class="basis-value" id="basis">—</span></div><div id="declared_rows"></div></section><div class="empty" id="declared_empty" hidden>No nutritional values were supplied to this view.</div>
<h2 class="block-title" id="references_title">Official references applicable to these values</h2><p class="block-note" id="references_note">A comparison appears only when the definition, basis and reference are compatible.</p><div id="references"></div><div class="empty" id="references_empty">No applicable official comparison has been supplied.</div><div class="method" id="method_note">Declared value and official reference are kept visually separate. If the comparison is not methodologically valid, BOTIA does not invent a percentage or a bar.</div></main><p class="disclaimer" id="disclaimer">Nutrition Facts contextualizes declared data. It does not classify the food as healthy or unhealthy.</p>
<script>
(()=>{'use strict';const p=new URLSearchParams(location.search);const decode=x=>{if(!x)return null;try{return JSON.parse(x)}catch(_){}try{let b=x.replace(/-/g,'+').replace(/_/g,'/');while(b.length%4)b+='=';return JSON.parse(new TextDecoder().decode(Uint8Array.from(atob(b),c=>c.charCodeAt(0))))}catch(_){return null}};const d=decode(p.get('payload'))||{basis:'',declared:[],references:[]};basis.textContent=d.basis||'—';const vals=Array.isArray(d.declared)?d.declared:[];declared_empty.hidden=vals.length>0;declared_card.hidden=!vals.length;vals.forEach(x=>{const r=document.createElement('div');r.className='nutrition-row'+(x.sub?' sub':'');const n=document.createElement('div');n.className='nutrient';n.textContent=x.label||x.key||'';const a=document.createElement('div');a.className='amount';a.textContent=[x.value,x.unit].filter(v=>v!==undefined&&v!==null&&String(v).trim()!=='').join(' ')||'—';r.append(n,a);declared_rows.appendChild(r)});const refs=Array.isArray(d.references)?d.references:[];references_empty.hidden=refs.length>0;refs.forEach(x=>{const c=document.createElement('article');c.className='ref-card';const h=document.createElement('div');h.className='ref-head';const n=document.createElement('h3');n.className='ref-name';n.textContent=x.label||x.nutrient||'Reference';h.appendChild(n);if(x.classification){const t=document.createElement('span');t.className='class-tag';t.textContent='Class '+x.classification;h.appendChild(t)}c.appendChild(h);if(x.declared){const q=document.createElement('p');q.className='declared';q.textContent=x.declared;c.appendChild(q)}const cls=String(x.classification||'').toUpperCase(),pct=Number(x.percent),show=(cls==='A'||cls==='B')&&Number.isFinite(pct)&&x.show_bar!==false;if(show){const w=document.createElement('div');w.className='bar-wrap';const tr=document.createElement('div');tr.className='track';const b=document.createElement('div');b.className='bar';b.style.width=Math.max(0,Math.min(100,pct))+'%';tr.appendChild(b);const m=document.createElement('div');m.className='bar-meta';m.innerHTML='<span></span><span class="percent"></span>';m.children[0].textContent=x.bar_label||'';m.children[1].textContent=pct+'%';w.append(tr,m);c.appendChild(w)}if(x.reference){const q=document.createElement('p');q.className='reference';q.textContent=x.reference;c.appendChild(q)}if(x.equivalent){const q=document.createElement('p');q.className='equivalent';q.textContent=x.equivalent;c.appendChild(q)}if(x.url){try{const u=new URL(x.url,location.origin);if(/^https?:$/.test(u.protocol)){const l=document.createElement('a');l.className='source';l.href=u;l.target='_blank';l.rel='noopener noreferrer';l.textContent=x.source||'Official source →';c.appendChild(l)}}catch(_){}}references.appendChild(c)})})();
</script><script defer src="/botia/assets/js/i18n-loader.js"></script></body></html>
