  "false_friends": {
    "_rule": "Words that translation engines get wrong. ALWAYS check context before translating.",
    "soy": {
      "_problem": "In an ingredient name, 'soy' is the legume, NOT the Spanish verb 'ser'. Engines have produced 'Yo soy isoflavonas', 'Io sono isoflavoni', 'Ik ben Isoflavones', 'Ben Isoflavones', 'Я изофлавоны'.",
      "_correct": "Always translate as the legume: soja, soia, soya, kedelai, 大豆, الصويا"
    },
    "can": {
      "_problem": "In 'BOTIA CAN', 'can' is the modal verb, NOT the container. Engines have produced '博蒂亚罐头' (BOTIA tin can) and 'بوتيا كان' (BOTIA was).",
      "_correct": "Use the interface_labels.can_title value above."
    },
    "gum": {
      "_problem": "In hydrocolloid names, 'gum' is the plant exudate, NOT chewing gum. And the different gums must not be swapped: tara gum has been rendered as tragacanth and as locust bean gum.",
      "_correct": "Each gum keeps its own botanical identity. Tara ≠ tragacanth ≠ locust bean ≠ guar ≠ karaya ≠ arabic."
    },
    "flavour": {
      "_problem": "British and American spelling coexist in the repo. The layer identifier is 'flavour' with U. The WebView filename is 'flavor.html' without U.",
      "_correct": "Layer identifier: flavour. Filename: flavor.html. Do not unify."
    },
    "natural": {
      "_problem": "'Natural flavouring' is a legal category, not a description. Translating it as 'sabor de la naturaleza' or similar loses the regulatory meaning.",
      "_correct": "Use the official regulatory term in each language."
    }
  },
  "translation_rules": {
    "_rule": "Rules any translation script MUST follow.",
    "prompt_language": "The translation prompt MUST be written in English. A prompt written in Spanish has caused DeepSeek to return Spanish instead of the target language.",
    "on_failure": "If a translation fails after retries, ABORT and report. NEVER return the original text — that has silently propagated Spanish into Italian files.",
    "source_language": "Always translate FROM i18n/en/. Never read the target language file as a source.",
    "verification": "After translating, compare the result against i18n/es/. If any string over 40 characters is identical, it is contamination — do not write the file. Exclude URLs and aliases from this check.",
    "short_strings": "Strings under 5 words are the highest risk. Give the engine context: instead of 'CAN', send 'section heading meaning what BOTIA is able to do'."
  },
